  {
    "@id": "https://w3id.org/euremap/resource/service-EUREMAP_032",
    "@type": [
      "https://w3id.org/euremap/ontology/Service"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "In vitro safety assessments in a 384-well format, including dose-response toxicity testing in human liver and porcine kidney cell models. Ecotoxicity assessment includes viability testing of rainbow trout gill cells (RTgill) and determination of LD50 values in marine and terrestrial invertebrate models including crustacean nauplii and green algae. We offer in vitro ADMET testing using the HepG2 (liver) cell line to support early-stage evaluation of hepatotoxicity, cellular uptake, and metabolic effects to aid compound selection and optimization."
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "EUREMAP_032"
      }
    ],
    "http://purl.org/dc/terms/source": [
