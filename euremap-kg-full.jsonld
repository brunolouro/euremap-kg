    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Schema for describing the EUREMAP marine natural-product\nbioprospecting service pipeline as a knowledge graph: who offers which service,\nat which pipeline step, through which research infrastructure, in which country,\nwith which techniques, what it consumes and what it produces. It acts as the\nsemantic control plane for service discovery, routing and governance; it does\nnot store scientific payload data."
      }
    ],
