  {
    "@id": "https://w3id.org/euremap/resource/service-EUREMAP_008",
    "@type": [
      "https://w3id.org/euremap/ontology/Service"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Production of microbial biomass from cultured strains under aerobic conditions in different formats using a suite of INFORS automated bioreactors ranging from 0.5 to 2 L, including four photobioreactors. This service includes scale-up to 10 L through continuous to semi-continuous cultivation, as well as optimisation of culture conditions using eight replicate bioreactors. Shake Flask Cultivation on INFORS Incubators with flask volumes up to 3L"
      }
    ],
