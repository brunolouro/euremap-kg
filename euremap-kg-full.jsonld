    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Assembly and analysis of raw DNA sequencing reads from environmental or biological samples to identify which organisms are present and what functions they may perform. The service includes quality control, taxonomic classification, gene prediction, and functional annotation using trusted databases. Results can reveal biological pathways, biosynthetic potential for natural product production, and other functional insights."
      }
